OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Any model id your endpoint serves; the client sends whatever it is
# given. Omit for z-ai/glm-5.3-flash, which is what the published results used.
# AUDITOR_MODEL=z-ai/glm-5.3-flash

# Optional. How much deliberation to ask for: off, low, medium or high. Slower
# and dearer on every endpoint. Omit to leave the model's own default alone.
# AUDITOR_REASONING=medium
