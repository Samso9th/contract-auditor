# Any OpenAI-compatible endpoint works. OpenRouter is the default because one
# key reaches Anthropic, Z.AI, Moonshot, DeepSeek and the rest, so a judge can
# run this with whatever credentials they already have.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
