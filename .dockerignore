# Build context hygiene. The Dockerfile copies specific directories rather than
# `.`, so nothing here is strictly load-bearing today, but a build context that
# contains secrets is one careless `COPY . .` away from baking them into a
# published image, and this image is published publicly.
.env
.env.*
**/.env
**/.env.*

.git
.github
reports/
eval/cases/
**/__pycache__/
**/*.pyc
**/node_modules/
**/dist/
**/.DS_Store

# The extractor binary is rebuilt inside the image for the target architecture;
# a host-built arm64 binary would silently break an amd64 image.
auditor/tools/goroutes/goroutes
eval/fixture/fixture

*.pdf
ddocs/
docs/

# No learned memory in the published image, ever. The ledger belongs to whoever
# ran the audit; baking one in would impose this project's fixture statistics on
# every repository that pulls the action.
.contract-auditor/
auditor/memory/*.jsonl
auditor/memory/rules.json
